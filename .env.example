# Server
NODE_ENV=development
PORT=8787
WEB_ORIGIN=http://localhost:4173
SESSION_ID=rise966

# mock is safe for local development; tiktok is anonymous, read-only observation
PROVIDER=mock
TIKTOK_UNIQUE_ID=

# Required for control sockets outside local/test mode. Never commit real values.
CONTROL_TOKEN=
# Optional token for overlay/read-only sockets. When set, read-only sockets must send auth.token.
OVERLAY_TOKEN=

# Optional durable Postgres connection. Without this, the process is explicitly ephemeral.
DATABASE_URL=
LOG_LEVEL=info

# Web build only: public HTTPS URL of your persistent service, never a secret.
VITE_GAME_SERVER_URL=
